# Public URL of this server (no trailing slash)
BASE_URL=https://mcp.evergreenjunction.com

# From the GHL Marketplace app: Advanced Settings > Auth
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# The version_id shown in the app's installation URL. If left empty, the app id
# (the part of GHL_CLIENT_ID before "-") is used, which matches the installation URL.
GHL_VERSION_ID=

# Long random string used to encrypt tokens. Generate with: openssl rand -hex 32
# Changing it signs everyone out.
TOKEN_SECRET=

# Supabase (Project Settings > API). Holds the agency connection, the activity log,
# and sends the sign-in codes. The service role key is secret: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional branding for the sign-in pages
BRAND_NAME=EverGreen Junction
PRODUCT_NAME=EverGreen MCP Connector
BRAND_LOGO_URL=

# Optional: lock the connector to one agency (HighLevel company id)
GHL_COMPANY_ID=
